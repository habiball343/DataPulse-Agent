# 复制为 .env 后填写。所有变量都带 DATAPULSE_ 前缀。

# ---- 大模型（任意 OpenAI 兼容接口）----
# DeepSeek
DATAPULSE_LLM_BASE_URL=https://api.deepseek.com
DATAPULSE_LLM_MODEL=deepseek-chat
DATAPULSE_LLM_API_KEY=sk-xxxx
# 通义千问（DashScope 兼容模式）示例：
# DATAPULSE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DATAPULSE_LLM_MODEL=qwen-plus

# ---- Embedding ----
# hash：离线的字符 n-gram 哈希向量，零依赖、开箱即用（默认）
# openai：任意 OpenAI 兼容的 Embedding 接口，如 SiliconFlow 的 BAAI/bge-m3
DATAPULSE_EMBEDDING_PROVIDER=hash
# DATAPULSE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# DATAPULSE_EMBEDDING_MODEL=BAAI/bge-m3
# DATAPULSE_EMBEDDING_API_KEY=sk-xxxx

# ---- 数据库与运行参数 ----
DATAPULSE_DB_PATH=data/tms_demo.db
DATAPULSE_MAX_ROWS=200
DATAPULSE_MAX_REPAIR_ROUNDS=3
